import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";

// Khởi tạo Supabase Admin Client
const supabaseAdmin = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY!
);

// BẢNG QUY ĐỔI CHUẨN BETA & GÓI THÁNG MỚI NHẤT
const CREDIT_MAPPING: Record<number, number> = {
  // 1. GÓI NẠP LẺ BETA
  20000: 96,      // 20k -> 96 Credits
  50000: 240,     // 50k -> 240 Credits
  100000: 530,    // 100k -> 530 Credits
  200000: 1080,   // 200k -> 1080 Credits

  // 2. GÓI THÁNG
  249000: 1200,   // Starter -> 1200 Credits
  499000: 2600,   // Pro -> 2600 Credits
  999000: 5500,   // Business -> 5500 Credits
};

export async function POST(req: Request) {
  try {
    const body = await req.json();

    // Lấy số tiền và nội dung chuyển khoản từ SePay bắn sang
    const transferAmount = Number(body.transferAmount || body.amount || 0);
    const content = String(body.content || body.description || "");

    // Tìm số credits tương ứng với số tiền nạp
    const creditsToAdd = CREDIT_MAPPING[transferAmount];

    if (!creditsToAdd) {
      return NextResponse.json({ message: "Số tiền không trùng khớp với các gói nạp" }, { status: 400 });
    }

    // Lấy User ID từ nội dung chuyển khoản (VD: REELBO_user_123)
    const match = content.match(/REELBO_([a-zA-Z0-9-]+)/i);
    const userId = match ? match[1] : null;

    if (!userId) {
      return NextResponse.json({ message: "Không tìm thấy User ID trong nội dung chuyển khoản" }, { status: 400 });
    }

    // Lấy số credits hiện tại của user trong Supabase
    const { data: userData, error: userError } = await supabaseAdmin
      ? await supabaseAdmin.from("users").select("credits").eq("id", userId).single()
      : { data: null, error: true };

    if (userError || !userData) {
      return NextResponse.json({ message: "Người dùng không tồn tại" }, { status: 404 });
    }

    // Cộng nối tiếp credits mới vào tài khoản user
    const newTotalCredits = (userData.credits || 0) + creditsToAdd;

    await supabaseAdmin
      .from("users")
      .update({ credits: newTotalCredits })
      .eq("id", userId);

    return NextResponse.json({ 
      success: true, 
      message: `Cộng thành công ${creditsToAdd} credits cho user ${userId}` 
    });

  } catch (err: any) {
    return NextResponse.json({ error: err.message }, { status: 500 });
  }
}